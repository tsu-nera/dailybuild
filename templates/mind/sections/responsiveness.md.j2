{% macro val(v, z, digits=1) -%}
{%- if v is none -%}-
{%- else -%}{{ v|number_format(digits) }}{% if z and z|abs >= 1.5 %} (z{{ '%+.1f'|format(z) }}){% endif %}
{%- endif -%}
{%- endmacro %}
