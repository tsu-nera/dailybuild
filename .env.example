# cp .env.example .env で作る（git mv しない。追跡されると .gitignore が効かない）
# iiyama（開発）と vaio（日次取得）に同じ .env を置く

# Home Assistant: プロフィール → セキュリティ → 長期アクセストークン（dailybuild 用に発行）
# URL は両機から届く tailnet 名にする（localhost だと iiyama から繋がらない）
HA_URL=http://vaio.example.ts.net:8123
HA_TOKEN=

# Toggl Track（2026-10-27 で凍結。toggl.py fetch でアーカイブを取り直すときだけ使う）: https://track.toggl.com/profile の API Token
TOGGL_API_TOKEN=

# Toggl 2.0（Focus API）: 日次の取得と push・start・stop（toggl.py）。token は toggl_sk_... で Track の API Token とは別
# organization を列挙する API は無い（/users/me/settings の tos_ack_decoupled_licenses のキーが organization_id）
# workspace_id は Track と同じ値
TOGGL_FOCUS_API_TOKEN=
TOGGL_FOCUS_ORGANIZATION_ID=
TOGGL_FOCUS_WORKSPACE_ID=

# Todoist: https://app.todoist.com/app/settings/integrations/developer の API トークン
# （完了ログの取得に使う。vaio の日次取得も読む）
TODOIST_API_TOKEN=

# HealthPlanet（タニタ）のログイン
HEALTHPLANET_LOGIN_ID=
HEALTHPLANET_PASSWORD=

# Habitica: https://habitica.com/user/settings/api の User ID と API Token
HABITICA_USER_ID=
HABITICA_API_TOKEN=

# Google Maps Platform: Places API (New) の Place Details で Timeline の place ID の名前を引く
# （iiyama と vaio で共有するキー。API 制限に Places API (New) を入れる）
GOOGLE_MAPS_API_KEY=

# Last.fm: https://www.last.fm/api/accounts の API key と Shared secret（無ければ /api/account/create で発行）
# 再生履歴を非公開にしているので取得には認証セッションが要る（lastfm.py fetch --login が config/lastfm_session.json を書く）
LASTFM_API_KEY=
LASTFM_API_SECRET=
LASTFM_USER=

# Homebox（持ち物の正本、#263）: vaio の scripts/ops/homebox。API key は UI のプロフィールか /api/v1/users/self/api-keys で発行
HOMEBOX_URL=http://vaio.example.ts.net:3100
HOMEBOX_API_KEY=

# Foursquare（Swarm のチェックイン取得、#92）: https://foursquare.com/developers でアプリを登録した Client ID / Secret
# アプリの Redirect URL に下と同じ値を登録する（swarm.py fetch --login が config/swarm_token.json を書く）
FOURSQUARE_CLIENT_ID=
FOURSQUARE_CLIENT_SECRET=
# FOURSQUARE_REDIRECT_URI=http://localhost:8765/callback
