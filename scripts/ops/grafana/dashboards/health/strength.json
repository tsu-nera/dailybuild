              "type": "timestamp",
              "timestampFormat": "2006-01-02"
            },
            {
              "selector": "muscle",
              "text": "muscle",
              "type": "string"
            },
            {
              "selector": "sets",
              "text": "セット",
              "type": "number"
            },
            {
              "selector": "target",
              "text": "目標",
              "type": "number"
            }
          ],
          "filterExpression": "muscle == \"${muscle}\""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "custom": {
            "drawStyle": "bars",
            "barAlignment": 1,
            "fillOpacity": 80,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false,
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
