    {
      "id": 12,
      "type": "barchart",
      "title": "週ごとのセット数: $muscle",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "dashboard-files"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 16,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "dashboard-files"
          },
          "type": "csv",
          "source": "url",
          "parser": "backend",
          "format": "table",
          "url": "http://files/sets.csv",
          "columns": [
            {
              "selector": "muscle",
              "text": "muscle",
              "type": "string"
            },
            {
              "selector": "week",
              "text": "週",
              "type": "string"
            },
            {
              "selector": "sets",
              "text": "セット",
              "type": "number"
            },
            {
              "selector": "target",
              "text": "目標",
              "type": "number"
            },
            {
              "selector": "axis_max",
              "text": "軸",
              "type": "number"
            }
          ],
          "filterExpression": "muscle == \"${muscle}\"",
          "url_options": {
            "method": "GET"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "xTickLabelRotation": -45,
        "showValue": "auto",
        "tooltip": {
          "mode": "single"
        },
        "xField": "週"
      },
      "transformations": [
        {
          "id": "configFromData",
          "options": {
            "configRefId": "A",
            "applyTo": {
              "id": "byName",
              "options": "セット"
            },
            "mappings": [
              {
                "fieldName": "目標",
                "handlerKey": "threshold1",
                "reducerId": "lastNotNull"
              },
              {
                "fieldName": "週",
                "handlerKey": "__ignore"
              },
              {
                "fieldName": "セット",
                "handlerKey": "__ignore"
              },
              {
                "fieldName": "軸",
                "handlerKey": "max",
                "reducerId": "lastNotNull"
              }
            ]
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "目標": true,
              "muscle": true,
              "軸": true
            }
          }
        }
      ],
      "repeat": "muscle",
      "repeatDirection": "h",
      "maxPerRow": 3,
      "description": "点線が exercise_muscles.yaml の週目標（sets.csv の target）"
