{
  "uid": "consumables",
  "title": "消耗品",
  "tags": [
    "dailybuild",
    "home"
  ],
  "timezone": "utc",
  "editable": true,
  "schemaVersion": 41,
  "time": {
    "from": "now-6y",
    "to": "now"
  },
  "timepicker": {
    "hidden": true
  },
  "refresh": "",
  "links": [
    {
      "title": "健康",
      "type": "dashboards",
      "tags": [
        "health"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true
    },
    {
      "title": "お金",
      "type": "dashboards",
      "tags": [
        "money"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true
    },
    {
      "title": "暮らし",
      "type": "dashboards",
      "tags": [
        "home"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "品目（品名をクリックで詳細）",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 16
      },
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "dashboard-files"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "dashboard-files"
          },
          "type": "csv",
          "source": "url",
          "parser": "backend",
          "format": "table",
          "url": "http://files/consumables.csv",
          "url_options": {
            "method": "GET"
          },
          "columns": [
            {
              "selector": "key",
              "text": "key",
              "type": "string"
            },
            {
              "selector": "ended_on",
              "text": "ended_on",
              "type": "string"
            },
            {
              "selector": "name",
              "text": "品目",
              "type": "string"
            },
            {
              "selector": "next_purchase",
              "text": "次に買う頃",
              "type": "string"
            },
            {
              "selector": "runs_out",
              "text": "尽きる頃",
              "type": "string"
            },
            {
              "selector": "monthly_yen",
              "text": "月額 円",
              "type": "number"
            },
            {
              "selector": "last_purchase",
              "text": "最終購入",
              "type": "string"
            },
            {
              "selector": "last_shop",
              "text": "最後の店",
              "type": "string"
            }
          ],
          "filterExpression": "ended_on == \"\""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "minWidth": 80
          },
          "noValue": ""
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "key"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "ended_on"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "品目"
            },
            "properties": [
              {
                "id": "custom.minWidth",
                "value": 240
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "詳細",
                    "url": "/d/consumable-detail?var-item=${__data.fields.key}"
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": true,
          "reducer": [
            "sum"
          ],
          "fields": [
            "月額 円"
          ],
          "countRows": false
        }
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "key": 0,
              "ended_on": 1,
              "品目": 2,
              "次に買う頃": 3,
              "尽きる頃": 4,
              "月額 円": 5,
              "最終購入": 6,
              "最後の店": 7
            }
          }
        }
      ]
    }
  ]
}
