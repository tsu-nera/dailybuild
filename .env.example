# cp .env.example .env で作る（git mv しない。追跡されると .gitignore が効かない）
# mouse（開発）と vaio（日次取得）に同じ .env を置く

# Home Assistant: プロフィール → セキュリティ → 長期アクセストークン（dailybuild 用に発行）
# URL は両機から届く tailnet 名にする（localhost だと mouse から繋がらない）
HA_URL=http://vaio.example.ts.net:8123
HA_TOKEN=

# Toggl Track: https://track.toggl.com/profile の API Token
TOGGL_API_TOKEN=

# Toggl 2.0（Focus API）: 手動の時間記録の取得（toggl.py fetch-focus）。token は toggl_sk_... で Track の API Token とは別
# organization を列挙する API は無い（/users/me/settings の tos_ack_decoupled_licenses のキーが organization_id）
# workspace_id は Track と同じ値
TOGGL_FOCUS_API_TOKEN=
TOGGL_FOCUS_ORGANIZATION_ID=
TOGGL_FOCUS_WORKSPACE_ID=

# Todoist: https://app.todoist.com/app/settings/integrations/developer の API トークン
# （完了ログの取得に使う。vaio の日次取得も読む）
TODOIST_API_TOKEN=

# HealthPlanet（タニタ）のログイン
HEALTHPLANET_LOGIN_ID=
HEALTHPLANET_PASSWORD=

# Habitica: https://habitica.com/user/settings/api の User ID と API Token
HABITICA_USER_ID=
HABITICA_API_TOKEN=

# Google Maps Platform: Places API (New) の Place Details で Timeline の place ID の名前を引く
# （mouse と vaio で共有するキー。API 制限に Places API (New) を入れる）
GOOGLE_MAPS_API_KEY=
