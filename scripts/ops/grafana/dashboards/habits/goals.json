{
  "uid": "goals",
  "title": "目標",
  "tags": [
    "dailybuild",
    "habits"
  ],
  "timezone": "Asia/Tokyo",
  "schemaVersion": 41,
  "editable": true,
  "refresh": "",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "目標",
      "description": "1行1目標。今週は途中（今日の分を含む）。目標値が空の行は目標を決めていない。行の「項目」を押すとその習慣の画面へ",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "dashboard-files"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 11
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "dashboard-files"
          },
          "type": "csv",
          "source": "url",
          "parser": "backend",
          "format": "table",
          "url": "http://files/goals_list.csv",
          "columns": [
            {
              "selector": "metric",
              "text": "項目",
              "type": "string"
            },
            {
              "selector": "target",
              "text": "目標",
              "type": "number"
            },
            {
              "selector": "this",
              "text": "今週",
              "type": "number"
            },
            {
              "selector": "prev",
              "text": "先週",
              "type": "number"
            },
            {
              "selector": "period",
              "text": "期間",
              "type": "string"
            },
            {
              "selector": "habit",
              "text": "習慣",
              "type": "string"
            },
            {
              "selector": "unit",
              "text": "単位",
              "type": "string"
            },
            {
              "selector": "link",
              "text": "link",
              "type": "string"
            }
          ],
          "url_options": {
            "method": "GET"
          }
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "項目": 0,
              "目標": 1,
              "今週": 2,
              "先週": 3,
              "期間": 4,
              "習慣": 5,
              "単位": 6,
              "link": 7
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "minWidth": 50,
            "align": "auto"
          },
          "noValue": ""
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "link"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "期間"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "習慣"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "単位"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "目標"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 56
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "今週"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 56
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "先週"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 56
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "項目"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "習慣の画面",
                    "url": "/d/${__data.fields.link}"
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 2,
      "type": "row",
      "title": "データ鮮度",
      "collapsed": true,
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 24,
        "h": 1
      },
      "panels": [
        {
          "id": 3,
          "type": "row",
          "title": "データ鮮度",
          "collapsed": true,
          "gridPos": {
            "x": 0,
            "y": 13,
            "w": 24,
            "h": 12
          },
          "panels": [
            {
              "id": 3,
              "type": "row",
              "title": "データ鮮度",
              "collapsed": true,
              "gridPos": {
                "x": 0,
                "y": 13,
                "w": 24,
                "h": 12
              },
              "panels": [
                {
                  "id": 3,
                  "type": "table",
                  "title": "データ鮮度",
                  "datasource": {
                    "type": "yesoreyeram-infinity-datasource",
                    "uid": "dashboard-files"
                  },
                  "gridPos": {
                    "x": 0,
                    "y": 13,
                    "w": 24,
                    "h": 12
                  },
                  "targets": [
                    {
                      "refId": "A",
                      "datasource": {
                        "type": "yesoreyeram-infinity-datasource",
                        "uid": "dashboard-files"
                      },
                      "type": "csv",
                      "source": "url",
                      "parser": "backend",
                      "format": "table",
                      "url": "http://files/freshness.csv",
                      "columns": [
                        {
                          "selector": "name",
                          "text": "ソース",
                          "type": "string"
                        },
                        {
                          "selector": "last",
                          "text": "最終日",
                          "type": "string"
                        },
                        {
                          "selector": "behind",
                          "text": "遅れ（日）",
                          "type": "number"
                        },
                        {
                          "selector": "tolerance",
                          "text": "許容（日）",
                          "type": "number"
                        }
                      ],
                      "url_options": {
                        "method": "GET"
                      }
                    }
                  ],
                  "fieldConfig": {
                    "defaults": {
                      "custom": {
                        "minWidth": 60
                      }
                    },
                    "overrides": []
                  },
                  "options": {},
                  "description": "遅れ・許容は collect_pipeline() の値。判定は付けない"
                }
              ]
            }
          ]
        }
      ]
    }
  ],
