      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "dashboard-files"
          },
          "type": "csv",
          "source": "url",
          "parser": "backend",
          "format": "table",
          "url": "http://files/daily.csv",
          "columns": [
            {
              "selector": "date",
              "text": "date",
              "type": "timestamp",
              "timestampFormat": "2006-01-02"
            },
            {
              "selector": "hrv",
              "text": "HRV",
              "type": "number"
            },
            {
              "selector": "hrv_base",
              "text": "HRV ベースライン",
              "type": "number"
            },
            {
              "selector": "hrv_lo",
              "text": "HRV 下限",
              "type": "number"
            },
            {
              "selector": "hrv_hi",
              "text": "HRV 上限",
              "type": "number"
            }
          ],
          "url_options": {
            "method": "GET"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "pointSize": 4,
            "showPoints": "always",
            "spanNulls": false,
            "barAlignment": 0,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "HRV (下限|上限)"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    4,
                    4
                  ]
                }
              },
              {
                "id": "custom.showPoints",
                "value": "never"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "gray"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "HRV ベースライン"
            },
            "properties": [
              {
                "id": "custom.showPoints",
                "value": "never"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "gray"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "description": "灰色はベースライン（60日移動）と ±1SD。mind レポート・STATE.md と同じ関数。前夜の状態を映す。欠測は空白（0にしない）。今日の行は途中。期間は右上の時間範囲で変える"
