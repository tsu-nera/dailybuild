            "applyTo": {
              "id": "byName",
              "options": "セット"
            },
            "mappings": [
              {
                "fieldName": "目標",
                "handlerKey": "threshold1",
                "reducerId": "lastNotNull"
              },
              {
                "fieldName": "セット",
                "handlerKey": "__ignore"
              },
              {
                "fieldName": "date",
                "handlerKey": "__ignore"
              }
            ]
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "目標": true,
              "muscle": true
            }
          }
        }
      ],
      "repeat": "muscle",
