      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "dashboard-files"
          },
          "type": "csv",
          "source": "url",
          "parser": "backend",
          "format": "table",
          "url": "http://files/strength_workouts.csv",
          "url_options": {
            "method": "GET"
          },
          "columns": [
            {
              "selector": "start_ms",
              "text": "start_ms",
              "type": "number"
            },
            {
              "selector": "minutes",
              "text": "値",
              "type": "number"
            }
          ],
          "filterExpression": "start_ms >= ${__from} && start_ms <= ${__to}"
