# cp .env.example .env で作る（git mv しない。追跡されると .gitignore が効かない）
# mouse（開発）と vaio（日次取得）に同じ .env を置く

# Home Assistant: プロフィール → セキュリティ → 長期アクセストークン（dailybuild 用に発行）
# URL は両機から届く tailnet 名にする（localhost だと mouse から繋がらない）
HA_URL=http://vaio.example.ts.net:8123
HA_TOKEN=

# Toggl Track: https://track.toggl.com/profile の API Token
TOGGL_API_TOKEN=

# HealthPlanet（タニタ）のログイン
HEALTHPLANET_LOGIN_ID=
HEALTHPLANET_PASSWORD=

# Habitica: https://habitica.com/user/settings/api の User ID と API Token
HABITICA_USER_ID=
HABITICA_API_TOKEN=
